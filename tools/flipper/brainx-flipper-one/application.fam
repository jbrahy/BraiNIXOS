App(
    appid="brainx_flipper_one",
    name="BraiNIX One",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="brainx_flipper_one_app",
    stack_size=4 * 1024,
    fap_category="Tools",
    fap_description=(
