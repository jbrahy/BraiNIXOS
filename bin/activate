#!/usr/bin/env bash
# bin/activate — hermetic BraiNIX toolchain shell.
#
# Spawns a fresh bash subshell with an *empty* environment, then re-injects
# only a sanitized whitelist of variables from the parent shell, then sources
# every file under bin/dependencies/activate/ in sorted order. The intent is
# that builds run against a known, minimal environment independent of the
# invoker's installed rust toolchain, Homebrew shims, or stray env vars.
#
# Security properties
# -------------------
# 1. Start from `env -i` (empty environment, zero inherited vars).
# 2. Re-inject only the vars in ALLOWED_ENV_VARS (HOME, USER, TERM, etc.).
# 3. Force a minimal PATH floor (/usr/bin:/bin:/usr/sbin:/sbin) before any
#    dependency file runs, so dep files start from a known-good base and
#    must *explicitly* add any tool they need.
# 4. Source every file in bin/dependencies/activate/ in lexical order so
#    dependency composition is deterministic (prefix files with 000-, 010-,
#    etc. to control order).
#
# Usage
# -----
#   ./bin/activate                    # interactive hermetic shell
#   ./bin/activate -c "command"       # run a single command hermetically
#
# Do NOT `source` this script — it must `exec`-replace into a clean shell.
#
# Exit the subshell (Ctrl-D or `exit`) to return to your original shell
# with its original environment intact; the outer shell is not modified.

set -euo pipefail

if [[ "${BASH_SOURCE[0]}" != "${0}" ]]; then
    echo "bin/activate must be executed, not sourced. Use: ./bin/activate" >&2
    return 1 2>/dev/null || exit 1
fi

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ACTIVATE_DIRECTORY="${REPO_ROOT}/bin/dependencies/activate"

if [[ ! -d "${ACTIVATE_DIRECTORY}" ]]; then
    echo "fatal: ${ACTIVATE_DIRECTORY} does not exist" >&2
    exit 1
fi

# Env vars to carry into the clean shell. Explicitly excluded: PATH (rebuilt),
# all RUST*, CARGO*, RUSTUP_*, PYTHON*, NODE_*, GEM_*, GOPATH, JAVA_HOME,
# anything that could point at a competing toolchain or leak host-specific
# build state. HOME and USER are required for bash to function; TERM and
# LANG so text rendering is sane; SSH_AUTH_SOCK so git over ssh still works.
ALLOWED_ENV_VARS=(
    HOME
    USER
    SHELL
    TERM
    LANG
    LC_ALL
    LC_CTYPE
    TZ
    SSH_AUTH_SOCK
    DISPLAY
    XDG_RUNTIME_DIR
)

# Non-interactive mode: ./bin/activate -c "command"
NON_INTERACTIVE_COMMAND=""
if [[ "${1:-}" == "-c" ]]; then
    if [[ $# -lt 2 ]]; then
        echo "usage: ./bin/activate -c \"command\"" >&2
        exit 2
    fi
    NON_INTERACTIVE_COMMAND="$2"
fi

# Build the rcfile that runs inside the clean shell.
# Using mktemp keeps invocations independent; the file is tiny and /tmp is
# cleared by the OS. We cannot use a trap-based cleanup because we `exec`.
RCFILE="$(mktemp "${TMPDIR:-/tmp}/brainix-activate-rc.XXXXXXXX")"

{
    echo "# BraiNIX hermetic shell rcfile (generated by bin/activate at $(date -u +%FT%TZ))"
    echo "# This file is regenerated on every ./bin/activate invocation."
    echo ""

    for allowed_variable_name in "${ALLOWED_ENV_VARS[@]}"; do
        if [[ -n "${!allowed_variable_name-}" ]]; then
            printf 'export %s=%q\n' "$allowed_variable_name" "${!allowed_variable_name}"
        fi
    done

    echo ""
    echo "# Minimal safe PATH floor before dep files run."
    echo 'export PATH="/usr/bin:/bin:/usr/sbin:/sbin"'

    echo ""
    printf 'export BRAINIX_REPO_ROOT=%q\n' "$REPO_ROOT"
    echo 'export BRAINIX_TOOLCHAIN_ACTIVE=1'

    echo ""
    echo "# Source each dependency file in sorted lexical order."
    printf 'for depfile in %q/*; do\n' "$ACTIVATE_DIRECTORY"
    echo '    if [[ -f "$depfile" ]]; then'
    echo '        source "$depfile"'
    echo '    fi'
    echo 'done'

    echo ""
    echo 'cd "$BRAINIX_REPO_ROOT"'

    if [[ -z "$NON_INTERACTIVE_COMMAND" ]]; then
        echo ''
        echo 'export PS1="(brainix) \w \$ "'
        echo 'echo "(brainix) hermetic toolchain shell ready."'
        echo 'echo "  rustc:  $(command -v rustc || echo not-found)"'
        echo 'echo "  cargo:  $(command -v cargo || echo not-found)"'
        echo 'echo "  Exit with Ctrl-D or \"exit\" to return to your original shell."'
    fi
} > "$RCFILE"

if [[ -n "$NON_INTERACTIVE_COMMAND" ]]; then
    # Non-interactive: env -i, bash reads rcfile via BASH_ENV then runs -c.
    exec env -i HOME="$HOME" BASH_ENV="$RCFILE" bash --noprofile -c "$NON_INTERACTIVE_COMMAND"
else
    # Interactive: env -i, bash starts with our rcfile.
    exec env -i HOME="$HOME" bash --noprofile --rcfile "$RCFILE" -i
fi
